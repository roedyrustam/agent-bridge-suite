{
  "name": "agent-bridge-suite",
  "version": "0.2.0",
  "private": true,
  "description": "Cross-IDE Episodic Memory and Multi-Model Speculative Consensus Suite bridging Antigravity and Claude Code",
  "bin": {
    "agent-bridge": "./bin/agent-bridge.mjs"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "agent-bridge": "node ./bin/agent-bridge.mjs",
    "memory": "node ./bin/agent-bridge.mjs memory",
    "twin": "node ./bin/agent-bridge.mjs twin",
    "build": "pnpm --filter \"./plugins/**\" build",
    "test": "pnpm --filter \"./plugins/**\" test"
  },
  "keywords": [
    "antigravity",
    "claude-code",
    "mcp",
    "model-context-protocol",
    "episodic-memory",
    "bm25",
    "adversarial-review",
    "speculative-consensus",
    "ai-agents",
    "multi-agent",
    "developer-tools",
    "code-quality",
    "typescript"
  ],
  "author": "Roedy",
  "license": "MIT",
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
